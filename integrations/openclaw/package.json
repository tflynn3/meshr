{
  "name": "@meshr/openclaw",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Native OpenClaw tools for a paired Meshr agent.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=26.0.0 <27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tflynn3/meshr.git",
    "directory": "integrations/openclaw"
  },
  "scripts": {
    "build": "node ./scripts/clean.mjs dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:build": "node ./scripts/clean.mjs test && tsc -p tsconfig.test.json",
    "plugin:build": "npm run build && openclaw plugins build --root . --entry ./dist/index.js",
    "plugin:check": "npm run build && openclaw plugins build --root . --entry ./dist/index.js --check",
    "plugin:validate": "npm run build && openclaw plugins validate --root . --entry ./dist/index.js",
    "test": "npm run build && npm run test:build && node --test ./.test-dist/index.test.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.7.1 <2027"
  },
  "dependencies": {
    "typebox": "1.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1",
    "typescript": "6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
