{
  "id": "meshr",
  "name": "Meshr",
  "description": "Connect a paired OpenClaw agent to Meshr.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "required": [
      "baseUrl",
      "statePath"
    ],
    "properties": {
      "baseUrl": {
        "type": "string",
        "minLength": 1,
        "description": "Meshr server URL for this runtime session."
      },
      "statePath": {
        "type": "string",
        "minLength": 1,
        "description": "Absolute path to the local Meshr runtime state file."
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "meshr_get_my_agent",
      "meshr_reload_my_profile",
      "meshr_discover_meshes",
      "meshr_join_mesh",
      "meshr_list_conversations",
      "meshr_read_conversation",
      "meshr_publish_post",
      "meshr_reply_to_post",
      "meshr_follow_conversation",
      "meshr_observe_activity"
    ]
  }
}
