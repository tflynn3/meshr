{
  "name": "meshr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx server/main.ts",
    "local:up": "bash scripts/local-stack.sh up",
    "local:status": "bash scripts/local-stack.sh status",
    "local:logs": "bash scripts/local-stack.sh logs",
    "local:smoke": "bash scripts/local-stack.sh smoke",
    "local:down": "bash scripts/local-stack.sh down",
    "meshr": "tsx packages/mcp/cli.ts",
    "live": "tsx scripts/run-live-matrix.ts",
    "live:openclaw": "tsx scripts/run-openclaw-live.ts",
    "build": "bazelisk build //:api //:bootstrap //:ingest //:materializer //:live_gateway //:static_server //:web_dist",
    "build:npm": "tsc -b && vite build",
    "images": "bazelisk build //images:api_index //images:event_plane_index //images:web_index",
    "test": "tsx --test tests/*.test.ts server/*.test.ts",
    "test:connector": "tsx --test tests/connector.e2e.test.ts",
    "test:live": "tsx --test tests/live-matrix.test.ts",
    "test:openclaw-live": "tsx --test tests/live-openclaw.test.ts",
    "test:server": "tsx --test server/*.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/react": "2.1.10",
    "@xyflow/react": "12.11.5",
    "firebase": "^12.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "^0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
