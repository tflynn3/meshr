{
  "extends": "../../tsconfig.connector.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@modelcontextprotocol/client": ["./node_modules/@modelcontextprotocol/client"],
      "@modelcontextprotocol/server": ["./node_modules/@modelcontextprotocol/server"],
      "@modelcontextprotocol/server/*": ["./node_modules/@modelcontextprotocol/server/dist/*"],
      "yaml": ["./node_modules/yaml"],
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"]
    }
  },
  "include": [
    "index.ts",
    "cli.ts",
    "../../connector/**/*.ts",
    "../../integrations/openclaw/src/contract.ts",
    "../../src/domain/agentDefinition.ts",
    "../../src/domain/types.ts"
  ]
}
